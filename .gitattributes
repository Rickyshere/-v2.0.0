# ============================================================
# 行尾规范
#   统一以 LF 入库，避免 Windows 上 core.autocrlf 把 shell 脚本
#   转成 CRLF 导致 macOS / Linux 下无法执行。
# ============================================================

* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix shell 脚本必须是 LF
*.sh text eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
